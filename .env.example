# ─── Vercel (required for GitHub Actions CI/CD) ───────────────────────────────
# Obtain from: https://vercel.com/account/tokens
VERCEL_TOKEN=

# Obtain from your Vercel team/org settings
VERCEL_ORG_ID=

# Obtain from the Vercel project settings
VERCEL_PROJECT_ID=

# ─── Site URL (used for OG images, sitemap, robots.txt) ──────────────────────
# Set this to the production domain once confirmed
NEXT_PUBLIC_SITE_URL=

# ─── Contact form (optional – leave blank to use mailto: fallback) ────────────
# Email address that receives contact form submissions
CONTACT_TO_EMAIL=

# Email address used as the sender
CONTACT_FROM_EMAIL=

# Resend API key (https://resend.com)
RESEND_API_KEY=
